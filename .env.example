# ことのあめ's Supabase project (its accounts; the record is kept in ke_records, read and written as the learner)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ことのあめ's address, for making an account or resetting a password (default https://polylinga.vercel.app)
NEXT_PUBLIC_KOTONOAME_URL=
# Optional: ことのあめ's Google OAuth client, once this app's addresses are among its authorized JavaScript origins
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# OpenAI: corrections and replies (/api/turn), hearing what was said (/api/hear), and the voice a reply falls back on
OPENAI_API_KEY=
# Optional: another model or reasoning effort for corrections and replies (default gpt-5.5, low), another
# transcription model, and the whole-service ceiling of sentences per server instance per day (default 5000)
TALK_MODEL=
TALK_EFFORT=
HEAR_MODEL=
TURNS_PER_DAY=

# Signs the Korean the app's AI wrote, so /api/say voices only that (any long random string)
SAY_SECRET=

# Vertex AI: Gemini text-to-speech for every voice, in ことのあめ's project. Without it replies fall back to OpenAI
# voices, and scripts/generate-audio.mjs cannot voice the prepared lines
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_KEY=
